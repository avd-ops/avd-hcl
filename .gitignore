/reports/
/out/

# Bicep build artifacts (`az bicep build` emits <module>.json next to the source)
/bicep/modules/*.json

# PowerShell / editor noise
*.psd1.bak
.vscode/
.idea/
*.swp

# OS
Thumbs.db
Desktop.ini
.DS_Store
