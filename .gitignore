# Real values live here and never get committed (docs/guardrails.md, rule 4).
terraform.tfvars
*.auto.tfvars.json
*.pkrvars.hcl
!example.pkrvars.hcl
# Backend settings for terraform init -backend-config (the backend block itself is committed, empty).
backend.hcl
*.backend.hcl
# The pipeline stage starts on local state; bootstrap.sh writes its backend.tf after the first apply.
environments/*/00-pipeline/backend.tf
*.tfplan
tfplan

# Terraform and Packer working state
.terraform/
*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info
crash.log
packer_cache/

# Your schema answers (scripts/schema/answers.py init). No secrets, but they name your groups.
/.avd/

# Operator output (reports, readiness results, evidence bundles)
/output/
readiness.json
*-readiness.json

# Editors and OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
Desktop.ini

# Lock files belong to roots (environments/), not to reusable modules.
modules/**/.terraform.lock.hcl
__pycache__/
