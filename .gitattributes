# Normalize to LF in the repo; let git decide the working-tree ending by default.
* text=auto

# These must stay LF in the working tree: a CRLF shebang fails with "bad interpreter",
# and CI runs on Linux.
.githooks/pre-commit    text eol=lf
*.sh                    text eol=lf
*.yml                   text eol=lf
*.yaml                  text eol=lf
*.tf                    text eol=lf
*.hcl                   text eol=lf
