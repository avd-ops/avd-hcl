# scripts/pipeline/bootstrap.sh writes this as backend.tf (git-ignored) after the first apply,
# then moves this stage's state into the storage it just created. Names only, no secrets.
terraform {
  backend "azurerm" {
    resource_group_name  = "rg-avd-sbx-pipeline"
    storage_account_name = "stavdsbxtf000000"
    container_name       = "tfstate"
    key                  = "avd/sandbox/pipeline.tfstate"
    use_azuread_auth     = true
  }
}
