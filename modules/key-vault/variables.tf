variable "name" {
  description = "Key Vault name (3-24 letters, digits and hyphens, globally unique). Purge protection keeps a deleted vault's name taken for 90 days."
  type        = string
  validation {
    condition     = can(regex("^[a-zA-Z][a-zA-Z0-9-]{1,22}[a-zA-Z0-9]$", var.name))
    error_message = "Key Vault names are 3-24 letters, digits and hyphens, starting with a letter."
  }
}

variable "location" {
  description = "Azure region."
  type        = string
}

variable "resource_group_name" {
  description = "Resource group for the vault."
  type        = string
}

variable "tags" {
  description = "Tags applied to every resource."
  type        = map(string)
  default     = {}
}

variable "private_endpoint_subnet_id" {
  description = "Subnet for the vault private endpoint."
  type        = string
}

variable "private_dns_zone_id" {
  description = "privatelink.vaultcore.azure.net zone ID."
  type        = string
}

variable "local_admin_username" {
  description = "Session host local admin username, stored next to the password."
  type        = string
}

variable "local_admin_password" {
  description = "Session host local admin password. Generated by the root module; nobody types it."
  type        = string
  sensitive   = true
  ephemeral   = true
}

variable "local_admin_password_version" {
  description = "Change this to write a new password to the vault."
  type        = string
  default     = "1"
}

variable "admin_group_object_ids" {
  description = "Entra groups allowed to read the break-glass secrets (Key Vault Secrets User)."
  type        = list(string)
  default     = []
}

variable "log_analytics_workspace_id" {
  description = "Log Analytics workspace for the vault's audit log."
  type        = string
}
